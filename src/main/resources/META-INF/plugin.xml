<!-- Plugin Configuration File. Read more: https://plugins.jetbrains.com/docs/intellij/plugin-configuration-file.html -->
<idea-plugin>
    <!-- Unique identifier of the plugin. It should be FQN. It cannot be changed between the plugin versions. -->
    <id>com.hawk.codex</id>

    <!-- Public plugin name should be written in Title Case.
         Guidelines: https://plugins.jetbrains.com/docs/marketplace/best-practices-for-listing.html#plugin-name -->
    <name>Codex</name>
    <vendor>hawkchose1@gamil.com</vendor>

    <description><![CDATA[
    Codex - AI 代码补全与终端集成工具<br>
    - 基于本地 Ollama 模型的 Inline 代码补全<br>
    - 快速发送代码到 Codex CLI 终端
    ]]></description>

    <!-- 依赖声明：必须声明依赖 Terminal 模块 -->
    <depends>com.intellij.modules.platform</depends>
    <depends>org.jetbrains.plugins.terminal</depends>

    <extensions defaultExtensionNs="com.intellij">
        <!-- 设置服务 -->
        <applicationService
                serviceImplementation="com.hawk.codex.settings.CodexSettings"/>

        <!-- 代码索引服务 (项目级别) -->
        <projectService
                serviceImplementation="com.hawk.codex.index.CodeIndexService"/>

        <!-- 设置界面 -->
        <applicationConfigurable
                parentId="tools"
                instance="com.hawk.codex.settings.CodexSettingsConfigurable"
                id="com.hawk.codex.settings"
                displayName="Codex Completion"/>

        <!-- Inline 补全提供者 -->
        <inlineCompletionProvider
                implementation="com.hawk.codex.completion.CodexInlineCompletionProvider"/>
    </extensions>

    <actions>
        <!-- 打开 Codex 终端（右侧工具栏按钮） -->
        <action id="com.hawk.codex.OpenCodexTerminalAction"
                class="com.hawk.codex.OpenCodexTerminalAction"
                text="Open Codex Terminal"
                description="Open Codex CLI in terminal">
            <add-to-group group-id="MainToolbarRight" anchor="first"/>
        </action>

        <action id="com.hawk.codex.SendToCodexAction"
                class="com.hawk.codex.SendToCodexAction"
                text="Send to Codex"
                description="发送文件路径到 codex 终端">
            <!-- 编辑器右键菜单 -->
            <add-to-group group-id="EditorPopupMenu" anchor="last"/>
            <!-- 项目视图右键菜单 -->
            <add-to-group group-id="ProjectViewPopupMenu" anchor="last"/>
        </action>

        <!-- 代码补全 Action -->
        <action id="com.hawk.codex.CodexCompletionAction"
                class="com.hawk.codex.completion.CodexCompletionAction"
                text="Codex: Trigger Completion"
                description="触发 AI 代码补全">
            <keyboard-shortcut keymap="$default" first-keystroke="alt BACK_SLASH"/>
            <add-to-group group-id="EditorPopupMenu" anchor="last"/>
        </action>

        <!-- 接受补全 Action -->
        <action id="com.hawk.codex.AcceptCompletionAction"
                class="com.hawk.codex.completion.AcceptCompletionAction"
                text="Codex: Accept Completion"
                description="接受 AI 代码补全">
            <keyboard-shortcut keymap="$default" first-keystroke="TAB"/>
        </action>
    </actions>
</idea-plugin>